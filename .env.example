# Local development: `make run` reads .env (copy this file).
# Names match the stack's pushrelay compose profile (boson-chat/stack).
DATABASE_URL=memory
#DATABASE_URL=postgres://pushrelay:pushrelay@localhost:5432/pushrelay?sslmode=disable
PUSHRELAY_PUBLIC_URL=http://localhost:8080
HTTP_ADDR=:8080
INTERNAL_ADDR=:3001
LOG_LEVEL=debug
PUSHRELAY_ENV=development
# Operator API on INTERNAL_ADDR (X-Internal-Token); empty = off.
PUSHRELAY_INTERNAL_TOKEN=dev-admin-token
#TRUSTED_PROXIES=

# APNs token auth (.p8). Without the key file apns / apns-sandbox are refused.
#PUSHRELAY_APNS_KEY_FILE=./secrets/apns.p8
#PUSHRELAY_APNS_KEY_ID=
#PUSHRELAY_APNS_TEAM_ID=
#PUSHRELAY_APNS_TOPIC=chat.boson.app
# FCM HTTP v1 service account. Without it fcm is refused.
#PUSHRELAY_FCM_CREDENTIALS_FILE=./secrets/fcm.json

# Attestation.
#PUSHRELAY_APP_ATTEST_APP_ID=TEAMID.chat.boson.app
#PUSHRELAY_APP_ATTEST_ENV=production
#PUSHRELAY_PLAY_INTEGRITY_PACKAGE=chat.boson.app
#PUSHRELAY_PLAY_INTEGRITY_CERT_SHA256=
#PUSHRELAY_PLAY_INTEGRITY_CREDENTIALS_FILE=
# One entry per line: a dev token the build sends as "attestation", or a device token.
#PUSHRELAY_DEV_ALLOWLIST_FILE=./secrets/dev-allowlist.txt

# Abuse limits (README "Limits").
#PUSHRELAY_MAILBOX_BURST=10
#PUSHRELAY_MAILBOX_INTERVAL=6s
#PUSHRELAY_MAILBOX_PER_DAY=300
#PUSHRELAY_INSTALL_PER_HOUR=10000
#PUSHRELAY_CREATE_PER_IP_PER_HOUR=20
#PUSHRELAY_MAILBOX_IDLE_DAYS=60
